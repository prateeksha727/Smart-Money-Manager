<Window x:Class="SmartMoneyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartMoneyManager.ViewModels"
        xmlns:v="clr-namespace:SmartMoneyManager.Views"
        Title="Smart Money Manager"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgDark}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">    <v:DashboardView/>     </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">     <v:ExpensesView/>      </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetViewModel}">       <v:BudgetView/>        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsightsViewModel}">     <v:InsightsView/>      </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriptionsViewModel}"><v:SubscriptionsView/> </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavingsGoalsViewModel}"> <v:SavingsGoalsView/>  </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestmentViewModel}">   <v:InvestmentView/>    </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BgSidebar}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Smart Money Manager"
                               Foreground="{StaticResource TxtPrimary}"
                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="👤 " Foreground="{StaticResource TxtSecondary}" FontSize="13"/>
                    <TextBlock Text="{Binding UserDisplay}"
                               Foreground="{StaticResource TxtSecondary}" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,16">
                    <Separator/>
                    <Button Content="⬛  Logout" Style="{StaticResource BtnNav}" Command="{Binding LogoutCmd}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,16,8,0">
                        <TextBlock Text="MENU" Foreground="{StaticResource TxtMuted}"
                                   FontSize="10" FontWeight="SemiBold" Margin="16,0,0,8"/>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Dashboard">
                            <TextBlock Text="📊  Dashboard"/>
                        </Button>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Expenses">
                            <TextBlock Text="💳  Expenses"/>
                        </Button>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Budget">
                            <TextBlock Text="📋  Budgets"/>
                        </Button>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Insights">
                            <TextBlock Text="🔍  Insights"/>
                        </Button>
                        <TextBlock Text="TOOLS" Foreground="{StaticResource TxtMuted}"
                                   FontSize="10" FontWeight="SemiBold" Margin="16,16,0,8"/>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Subscriptions">
                            <TextBlock Text="🔄  Subscriptions"/>
                        </Button>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Savings">
                            <TextBlock Text="🏦  Savings Goals"/>
                        </Button>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding NavCmd}" CommandParameter="Investment">
                            <TextBlock Text="📈  Investment Sim"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDark}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>
