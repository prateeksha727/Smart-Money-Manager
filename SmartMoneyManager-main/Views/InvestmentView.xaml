<UserControl x:Class="SmartMoneyManager.Views.InvestmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgDark}">
        <StackPanel Margin="24">
            <TextBlock Text="Investment Simulator" Style="{StaticResource TxtHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="INITIAL AMOUNT ($)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding InitialAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="MONTHLY CONTRIBUTION ($)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding MonthlyContrib, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="ANNUAL RETURN (%)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding AnnualReturn, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="TIME HORIZON (YEARS)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding Years, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                        <Separator Margin="0,0,0,14"/>
                        <TextBlock Text="PROJECTED RESULTS" Style="{StaticResource TxtCardTitle}" FontSize="12"/>

                        <TextBlock Text="{Binding FinalValue, StringFormat='₹{0:0.00}'}"
                                   Foreground="{StaticResource Green}"
                                   FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TotalInvested, StringFormat='Invested: ₹{0:0.00}'}"
                                   Foreground="{StaticResource TxtSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding TotalGrowth, StringFormat='Growth: ₹{0:0.00}'}"
                                   Foreground="{StaticResource Teal}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Growth Projection" Style="{StaticResource TxtCardTitle}" FontSize="13" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding ChartSeries}"
                                            XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Height="340" AnimationsSpeed="0:0:0.3" Background="Transparent"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border Width="14" Height="14" Background="#0097A7" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Invested" Foreground="{StaticResource TxtSecondary}" FontSize="12" Margin="0,0,20,0"/>
                            <Border Width="14" Height="14" Background="#4CAF50" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Growth"   Foreground="{StaticResource TxtSecondary}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
