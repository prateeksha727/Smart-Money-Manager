<UserControl x:Class="SmartMoneyManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgDark}">
        <StackPanel Margin="24">
            <TextBlock Text="Dashboard" Style="{StaticResource TxtHeader}"/>

            <!-- KPI cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource SmallCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SPENT THIS MONTH" Style="{StaticResource TxtCardTitle}"/>
                        <TextBlock Text="{Binding TotalSpent, StringFormat='₹{0:0.00}'}"
                                   Style="{StaticResource TxtCardValue}" Foreground="{StaticResource Red}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SmallCard}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="REMAINING BUDGET" Style="{StaticResource TxtCardTitle}"/>
                        <TextBlock Text="{Binding Remaining, StringFormat='₹{0:0.00}'}"
                                   Style="{StaticResource TxtCardValue}" Foreground="{StaticResource Green}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SmallCard}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="DAILY AVERAGE" Style="{StaticResource TxtCardTitle}"/>
                        <TextBlock Text="{Binding DailyAverage, StringFormat='₹{0:0.00}'}"
                                   Style="{StaticResource TxtCardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SmallCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOP CATEGORY" Style="{StaticResource TxtCardTitle}"/>
                        <TextBlock Text="{Binding TopCategory}" Style="{StaticResource TxtCardValue}"
                                   FontSize="18" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Spending by Category" Style="{StaticResource TxtCardTitle}" FontSize="13"/>
                        <lvc:PieChart Series="{Binding PieSeries}" Height="200"
                                      LegendPosition="Right" AnimationsSpeed="0:0:0.3"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Last 7 Days" Style="{StaticResource TxtCardTitle}" FontSize="13"/>
                        <lvc:CartesianChart Series="{Binding BarSeries}"
                                            XAxes="{Binding BarXAxes}" YAxes="{Binding BarYAxes}"
                                            Height="200" AnimationsSpeed="0:0:0.3" Background="Transparent"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent transactions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent Transactions" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecentExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Category.Icon}"
                                                   FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource TxtPrimary}" FontSize="13"/>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                       Foreground="{StaticResource TxtSecondary}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Amount, StringFormat='₹{0:0.00}'}"
                                                   Foreground="{StaticResource Red}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
