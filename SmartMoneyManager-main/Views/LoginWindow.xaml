<Window x:Class="SmartMoneyManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmartMoneyManager.Converters"
        Title="Smart Money Manager"
        Width="900" Height="580"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource BgDark}">

    <Window.Resources>
        <conv:BoolToVisConverter    x:Key="BoolVis"/>
        <conv:InvBoolToVisConverter x:Key="InvVis"/>
        <conv:StrToVisConverter     x:Key="StrVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left decorative panel -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0D1B2A" Offset="0"/>
                    <GradientStop Color="#FF1A3A5C" Offset="0.5"/>
                    <GradientStop Color="#FF004D5A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" Margin="48">
                <TextBlock Text="💰" FontSize="52" Margin="0,0,0,16"/>
                <TextBlock Text="Smart Money" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Manager" Foreground="{StaticResource Teal}" FontSize="30" FontWeight="Bold" Margin="0,0,0,24"/>
                <TextBlock TextWrapping="Wrap" Foreground="#CCFFFFFF" FontSize="14" LineHeight="22">
                    Take control of your finances.&#x0a;Track spending, set budgets, reach your goals.
                </TextBlock>
                <StackPanel Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✓ " Foreground="{StaticResource Teal}" FontWeight="Bold"/>
                        <TextBlock Text="Smart expense tracking" Foreground="#CCFFFFFF" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✓ " Foreground="{StaticResource Teal}" FontWeight="Bold"/>
                        <TextBlock Text="Budget alerts and insights" Foreground="#CCFFFFFF" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✓ " Foreground="{StaticResource Teal}" FontWeight="Bold"/>
                        <TextBlock Text="Investment simulator" Foreground="#CCFFFFFF" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right panel -->
        <Border Grid.Column="1" Background="{StaticResource BgMedium}">
            <Grid>
                <!-- LOGIN FORM -->
                <StackPanel Visibility="{Binding ShowRegister, Converter={StaticResource InvVis}}"
                            VerticalAlignment="Center" Margin="44,0">

                    <TextBlock Text="Welcome Back" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Sign in to your account"
                               Foreground="{StaticResource TxtSecondary}" FontSize="13" Margin="0,0,0,32"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource TxtLabel}"/>
                    <TextBox x:Name="TxtUser" Style="{StaticResource TxtBox}"
                             Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" KeyDown="OnKeyDown"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource TxtLabel}"/>
                    <PasswordBox x:Name="PbLogin" Style="{StaticResource PwdBox}"
                                 Margin="0,0,0,8" KeyDown="OnKeyDown"/>

                    <!-- Error box — only visible when LoginError is non-empty -->
                    <Border Background="#22EF5350" CornerRadius="6" Padding="10,7" Margin="0,0,0,16"
                            Visibility="{Binding LoginError, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding LoginError}" Foreground="{StaticResource Red}"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="SIGN IN" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch" Height="44" FontSize="14" Margin="0,0,0,20"
                            Click="LoginClick"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Don't have an account?  "
                                   Foreground="{StaticResource TxtSecondary}" FontSize="13"/>
                        <TextBlock Text="Create one" Foreground="{StaticResource Teal}"
                                   FontSize="13" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding GoRegisterCmd}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- REGISTER FORM -->
                <ScrollViewer Visibility="{Binding ShowRegister, Converter={StaticResource BoolVis}}"
                              VerticalScrollBarVisibility="Auto" Margin="44,32,44,24">
                    <StackPanel>
                        <TextBlock Text="Create Account" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Join Smart Money Manager"
                                   Foreground="{StaticResource TxtSecondary}" FontSize="13" Margin="0,0,0,24"/>

                        <TextBlock Text="USERNAME *" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="DISPLAY NAME (optional)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding RegName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="EMAIL (optional)" Style="{StaticResource TxtLabel}"/>
                        <TextBox Style="{StaticResource TxtBox}"
                                 Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="PASSWORD *" Style="{StaticResource TxtLabel}"/>
                        <PasswordBox x:Name="PbReg" Style="{StaticResource PwdBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="CONFIRM PASSWORD *" Style="{StaticResource TxtLabel}"/>
                        <PasswordBox x:Name="PbConfirm" Style="{StaticResource PwdBox}" Margin="0,0,0,10"/>

                        <Border Background="#22EF5350" CornerRadius="6" Padding="10,7" Margin="0,0,0,16"
                                Visibility="{Binding RegError, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding RegError}" Foreground="{StaticResource Red}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="CREATE ACCOUNT" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Height="44" FontSize="14" Margin="0,0,0,16"
                                Click="RegisterClick"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Already have an account?  "
                                       Foreground="{StaticResource TxtSecondary}" FontSize="13"/>
                            <TextBlock Text="Sign in" Foreground="{StaticResource Teal}"
                                       FontSize="13" Cursor="Hand" FontWeight="SemiBold">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding GoLoginCmd}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
