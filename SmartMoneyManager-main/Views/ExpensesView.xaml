<UserControl x:Class="SmartMoneyManager.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SmartMoneyManager.Converters">
    <UserControl.Resources>
        <conv:EditLabelConverter x:Key="EditLabel"/>
    </UserControl.Resources>
    <Grid Margin="24" Background="{StaticResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Form -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Add / Edit Expense" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,18"/>

                <TextBlock Text="DESCRIPTION" Style="{StaticResource TxtLabel}"/>
                <TextBox Style="{StaticResource TxtBox}"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="AMOUNT ($)" Style="{StaticResource TxtLabel}"/>
                <TextBox Style="{StaticResource TxtBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="DATE" Style="{StaticResource TxtLabel}"/>
                <DatePicker SelectedDate="{Binding Date}"
                            Background="{StaticResource BgInput}" Foreground="{StaticResource TxtPrimary}"
                            BorderBrush="{StaticResource Border}" Margin="0,0,0,12"/>

                <TextBlock Text="CATEGORY" Style="{StaticResource TxtLabel}"/>
                <ComboBox Style="{StaticResource CmbBox}"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelCategory}"
                          DisplayMemberPath="Name" Margin="0,0,0,12"/>

                <CheckBox Content="Essential expense" IsChecked="{Binding IsEssential}"
                          Foreground="{StaticResource TxtSecondary}" Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="40"
                            Content="{Binding IsEditing, Converter={StaticResource EditLabel}}"
                            Style="{StaticResource BtnPrimary}" Command="{Binding SaveCmd}"/>
                    <Button Grid.Column="2" Height="40" Content="Clear" Padding="14,0"
                            Style="{StaticResource BtnGhost}" Command="{Binding ClearCmd}"/>
                </Grid>
                <Button Content="🗑  Delete Selected" Style="{StaticResource BtnDanger}"
                        Command="{Binding DeleteCmd}" Margin="0,8,0,0" Height="36"/>
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="All Expenses" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TxtPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBox Style="{StaticResource TxtBox}" Width="200" Height="36"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                          Style="{StaticResource DGrid}"
                          ColumnHeaderStyle="{StaticResource DGridHdr}"
                          RowStyle="{StaticResource DGridRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Icon"        Binding="{Binding Category.Icon}"        Width="48"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}"          Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category"    Binding="{Binding Category.Name}"        Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Date"        Width="80"  IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Date" StringFormat="{}{0:MMM dd}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Amount"      Width="88"  IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Amount" StringFormat="₹{0:0.00}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
