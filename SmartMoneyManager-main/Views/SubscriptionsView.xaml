<UserControl x:Class="SmartMoneyManager.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SmartMoneyManager.Converters">
    <UserControl.Resources>
        <conv:EditLabelConverter x:Key="EditLabel"/>
    </UserControl.Resources>
    <Grid Margin="24" Background="{StaticResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Add / Edit Subscription" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TxtPrimary}" Margin="0,0,0,18"/>

                <TextBlock Text="NAME" Style="{StaticResource TxtLabel}"/>
                <TextBox Style="{StaticResource TxtBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="MONTHLY COST ($)" Style="{StaticResource TxtLabel}"/>
                <TextBox Style="{StaticResource TxtBox}"
                         Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="NEXT PAYMENT DATE" Style="{StaticResource TxtLabel}"/>
                <DatePicker SelectedDate="{Binding NextDate}"
                            Background="{StaticResource BgInput}" Foreground="{StaticResource TxtPrimary}"
                            BorderBrush="{StaticResource Border}" Margin="0,0,0,12"/>

                <TextBlock Text="CATEGORY" Style="{StaticResource TxtLabel}"/>
                <ComboBox Style="{StaticResource CmbBox}" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding Category}" Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="40"
                            Content="{Binding IsEditing, Converter={StaticResource EditLabel}}"
                            Style="{StaticResource BtnPrimary}" Command="{Binding SaveCmd}"/>
                    <Button Grid.Column="2" Height="40" Content="Clear" Padding="12,0"
                            Style="{StaticResource BtnGhost}" Command="{Binding ClearCmd}"/>
                </Grid>
                <Button Content="Delete Selected" Style="{StaticResource BtnDanger}"
                        Command="{Binding DeleteCmd}" Margin="0,8,0,0" Height="36"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Active Subscriptions" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TxtPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="{StaticResource BgInput}" CornerRadius="20" Padding="14,6">
                        <TextBlock Text="{Binding TotalMonthly, StringFormat='Total: ₹{0:0.00}/mo'}"
                                   Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelSub}"
                          Style="{StaticResource DGrid}"
                          ColumnHeaderStyle="{StaticResource DGridHdr}"
                          RowStyle="{StaticResource DGridRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"         Binding="{Binding Name}"                                            Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category"     Binding="{Binding Category}"                                        Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Monthly Cost" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="MonthlyCost" StringFormat="₹{0:0.00}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Next Payment" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="NextPaymentDate" StringFormat="{}{0:MMM dd, yyyy}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
